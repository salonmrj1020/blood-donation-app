rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Email verification codes - users can read/write their own
    match /emailVerificationCodes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users can read and write their own user document
    // Admins can read any user document for verification purposes
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Admins collection - authenticated users can read/write (for initial admin setup)
    // In production, you might want to restrict this further
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }
    
    // Verification logs - only admins can read/write
    match /verification_logs/{logId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Pending verification applications - users can create/update their own, admins can read/write all
    match /pendingVerifications/{userId} {
      allow read: if request.auth != null && 
        (request.auth.uid == userId || 
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Admin actions log - only admins can read/write
    match /adminActions/{actionId} {
      allow read, write: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Donors collection - users can read all donors and create/update their own
    // Admins can write any donor document for verification
    match /donors/{donorId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == donorId;
      allow update: if request.auth != null && 
        (request.auth.uid == donorId || 
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow delete: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Blood requests - authenticated users can read all, write their own
    // Admins can delete any blood request
    match /bloodRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.requesterId;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.requesterId || 
         request.auth.uid in resource.data.get('matchedDonors', []) ||
         request.auth != null); // Allow any authenticated user to update status
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.requesterId ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      // Allow any authenticated user to delete expired requests (for auto-cleanup)
      allow delete: if request.auth != null && 
        resource.data.status == 'pending' &&
        resource.data.expiresAt != null &&
        resource.data.expiresAt < request.time;
    }
    
    // Chats - participants can read and write
    match /chats/{chatId} {
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null && 
        request.auth.uid in resource.data.participants;
      // Allow set (create or update) with merge when user is in participants
      allow write: if request.auth != null &&
        request.auth.uid in request.resource.data.participants;
        
      // Chat messages subcollection
      match /messages/{messageId} {
        allow read, write: if request.auth != null && 
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }

      // Read status subcollection
      match /readStatus/{userId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Notifications - users can read their own notifications, system can create notifications
    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Topic notifications - system can create topic-based notifications
    match /topicNotifications/{topicNotificationId} {
      allow read, write: if request.auth != null;
    }
    
    // User notifications history - users can read their own notification history
    match /userNotifications/{userNotificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Donations - users can read/write their own donations, admins can read all
    match /donations/{donationId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.donorId || 
         request.auth.uid == resource.data.recipientId ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow create: if request.auth != null && 
        (request.auth.uid == request.resource.data.donorId || 
         request.auth.uid == request.resource.data.recipientId);
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.donorId || 
         request.auth.uid == resource.data.recipientId ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
      allow delete: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}